using <0.6>

!! gamescope-manager - zarzadzanie sesja gamescope + Steam Big Picture dla
!! HackerOS Gaming Edition. Przepisane z Go na HackerScript.

get <std:string> import <str_trim::str_split::str_join::str_starts_with::str_index_of>
get <work:common::sys> import <geteuid::sleep_secs::parse_int_or::ensure_dirs::bool_str>
get <work:common::distro> import <check_distro>
get <work:common::mode> import <state_dir::log_dir::config_dir>
get <work:common::style> import <primary::secondary::accent::red::gray::dim::white::green_n::yellow_n::pad_right::divider>
get <work:common::ui> import <banner::ok_msg::err_msg::warn_msg::info_msg::section::cmd_row>

include <config>
include <display>
include <session>
include <health>
include <runner>

fun version() -> Str [ end "0.3.0" ]

fun print_banner() [
    banner("gamescope-manager", "v" + version() + "  ·  Debian Testing (Forky)  ·  PC / Laptop")
]

fun die(msg: Str) [
    err_msg(msg)
    exit(1)
]

!! ---- help ------------------------------------------------------------------------------

fun rows(items: List<List<Str>>) [
    for it in items [
        cmd_row(it[0].clone(), it[1].clone(), 36)
    ]
]

