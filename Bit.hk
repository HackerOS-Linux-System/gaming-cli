[package]
-> name        => gaming-cli
-> version     => 0.3.0
-> description => HackerOS Gaming Edition: gaming-cli, gaming i gamescope-manager - 100% HackerScript (Bit.hk workspace).
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0
-> lang        => HackerScript
-> using       => 0.6

[workspace]
-> members => [source-code/common, source-code/gamescope-manager, source-code/gaming-cli, source-code/gaming]

[build]
-> link => static

[default-build]
-> profile => release

[commands]
-> build-all
--> run => ./scripts/build.sh
--> description => Zbuduj gaming-cli, gaming i gamescope-manager do katalogu bin/
-> install
--> run => ./scripts/install.sh
--> description => Zbuduj (jesli trzeba) i zainstaluj calosc do / (DESTDIR i PREFIX wspierane)
-> uninstall
--> run => ./scripts/uninstall.sh
--> description => Usun zainstalowane pliki (konfiguracja i stan zostaja)
-> clean
--> run => rm -rf bin .build
--> description => Usun artefakty budowania
